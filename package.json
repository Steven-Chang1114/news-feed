{
  "name": "news-feed",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Search news, summarise and score sentiment with an LLM, and build a personal digest.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "api-contract",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev -w server\" \"npm:dev -w web\"",
    "build": "npm run build -w web && npm run build -w server",
    "start": "npm run start -w server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
