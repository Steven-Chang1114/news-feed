# Copy to .env and fill in. NEVER commit .env.
# In production these are set as environment variables on the host (Render), not in a file.

# --- Server ---
NODE_ENV=development
PORT=3000
# Comma-separated origins allowed to call the API. Only used in development;
# in production the SPA is served by this same process, so no CORS is needed.
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# Local (via docker compose up -d):
DATABASE_URL=postgresql://newsfeed:newsfeed@localhost:5432/newsfeed
#
# In production this is not set by hand: render.yaml declares the database, and
# Render injects its connection string into the service.

# The repository integration tests DROP and recreate every table, so they refuse to
# run unless this is set explicitly — pointing them at DATABASE_URL by accident must
# be impossible, not merely unlikely. Unset, those tests report as skipped.
#   docker exec news-feed-postgres psql -U newsfeed -d postgres -c "CREATE DATABASE newsfeed_test"
TEST_DATABASE_URL=postgresql://newsfeed:newsfeed@localhost:5432/newsfeed_test

# --- News provider ---
# Free key from https://gnews.io (100 requests/day)
GNEWS_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano
